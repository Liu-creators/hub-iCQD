```

### 4.7 价值目标表 `cfg_biz_target`

> 运营经理在线维护，本库作为 Chat BI 查询的统一入口；如湖表已有目标表，此表为同步副本或视图。

```sql
CREATE TABLE cfg_biz_target (
  id            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  customer_id   VARCHAR(64)   NOT NULL COMMENT '客户ID',
  target_year   SMALLINT      NOT NULL COMMENT '目标年度',
  target_type   VARCHAR(32)   NOT NULL COMMENT 'ARR/order_amount',
  target_value  DECIMAL(18,2) NOT NULL COMMENT '目标值',
  currency      VARCHAR(8)    NOT NULL DEFAULT 'USD',
  status        VARCHAR(16)   NOT NULL DEFAULT 'active' COMMENT 'active/draft/archived',
  maintained_by VARCHAR(64)   NOT NULL COMMENT '维护人',
  source        VARCHAR(32)   NOT NULL DEFAULT 'manual' COMMENT 'manual/lake_sync',
  created_at    DATETIME(3)   NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  updated_at    DATETIME(3)   NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  UNIQUE KEY uk_customer_year_type_status (customer_id, target_year, target_type, status),
  KEY idx_year_status (target_year, status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='客户年度价值目标';
```

