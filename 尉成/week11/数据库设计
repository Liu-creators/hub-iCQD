## 5. 运行时库表设计

### 5.1 会话表 `rt_chat_session`

```sql
CREATE TABLE rt_chat_session (
  id             BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  session_id     VARCHAR(64)  NOT NULL COMMENT '会话ID',
  user_id        VARCHAR(64)  NOT NULL COMMENT '用户ID',
  user_role      VARCHAR(32)  NOT NULL COMMENT 'CSM/manager/region',
  region_id      VARCHAR(64)  NULL COMMENT '区域ID',
  team_id        VARCHAR(64)  NULL COMMENT '团队ID',
  status         VARCHAR(32)  NOT NULL DEFAULT 'IDLE' COMMENT '状态机状态',
  intent_code    VARCHAR(64)  NULL COMMENT '当前意图',
  slots_json     JSON         NULL COMMENT '当前槽位',
  clarify_round  INT          NOT NULL DEFAULT 0 COMMENT '已澄清轮次',
  pending_rule_id VARCHAR(64) NULL COMMENT '待响应澄清规则',
  trace_id       VARCHAR(64)  NULL COMMENT '最近一次链路ID',
  message_count  INT          NOT NULL DEFAULT 0,
  started_at     DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  last_active_at DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  closed_at      DATETIME(3)  NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uk_session_id (session_id),
  KEY idx_user_active (user_id, last_active_at),
  KEY idx_status_active (status, last_active_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='会话主表';
```

### 5.2 消息表 `rt_chat_message`

```sql
CREATE TABLE rt_chat_message (
  id            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  message_id    VARCHAR(64)  NOT NULL COMMENT '消息ID',
  session_id    VARCHAR(64)  NOT NULL COMMENT '会话ID',
  trace_id      VARCHAR(64)  NULL COMMENT '链路ID',
  role          VARCHAR(16)  NOT NULL COMMENT 'user/assistant/system',
  msg_type      VARCHAR(32)  NOT NULL COMMENT 'text/clarify_option/clarify_confirm/customer_disambiguation/result_card/result_table/result_count/reject_guide/error_notice',
  content_json  JSON         NOT NULL COMMENT '消息体',
  intent_code   VARCHAR(64)  NULL COMMENT '消息关联意图',
  seq_no        INT          NOT NULL COMMENT '会话内序号',
  token_usage   INT          NULL COMMENT 'LLM token 消耗（助手消息）',
  latency_ms    INT          NULL COMMENT '处理耗时',
  created_at    DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  UNIQUE KEY uk_message_id (message_id),
  KEY idx_session_seq (session_id, seq_no),
  KEY idx_trace (trace_id),
  KEY idx_created_at (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='会话消息';
```

> `content_json` 存储完整消息体（澄清卡片、结果卡片、脚注）。列表类结果的大数据不落库，仅存 `result_ref` 与摘要，明细按需从湖表重查。

### 5.3 澄清记录表 `rt_clarify_record`

```sql
CREATE TABLE rt_clarify_record (
  id              BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  record_id       VARCHAR(64)  NOT NULL COMMENT '记录ID',
  session_id      VARCHAR(64)  NOT NULL,
  trace_id        VARCHAR(64)  NOT NULL,
  rule_id         VARCHAR(64)  NOT NULL COMMENT '澄清规则',
  intent_code     VARCHAR(64)  NOT NULL,
  slot_name       VARCHAR(64)  NULL,
  round_no        INT          NOT NULL COMMENT '第几轮澄清',
  question_text   TEXT         NOT NULL COMMENT '实际展示话术',
  options_json    JSON         NULL COMMENT '展示选项快照',
  selected_key    VARCHAR(64)  NULL COMMENT '用户选择选项',
  selected_value  JSON         NULL COMMENT '回填槽位值',
  is_default      TINYINT(1)   NOT NULL DEFAULT 0 COMMENT '是否默认/超时应用',
  response_ms     INT          NULL COMMENT '用户响应耗时',
  status          VARCHAR(16)  NOT NULL DEFAULT 'shown' COMMENT 'shown/selected/timeout/abandoned',
  created_at      DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  responded_at    DATETIME(3)  NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uk_record_id (record_id),
  KEY idx_session (session_id),
  KEY idx_rule_status (rule_id, status),
  KEY idx_created_at (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='澄清交互记录';
```

### 5.4 查询执行表 `rt_query_execution`

```sql
CREATE TABLE rt_query_execution (
  id               BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  execution_id     VARCHAR(64)  NOT NULL COMMENT '执行ID',
  session_id       VARCHAR(64)  NOT NULL,
  message_id       VARCHAR(64)  NULL COMMENT '关联助手消息',
  trace_id         VARCHAR(64)  NOT NULL,
  intent_code      VARCHAR(64)  NOT NULL,
  metric_codes     JSON         NULL COMMENT '涉及指标',
  slots_json       JSON         NOT NULL COMMENT '最终槽位',
  default_slots    JSON         NULL COMMENT '使用默认值的槽位',
  permission_filter JSON        NOT NULL COMMENT '权限过滤条件',
  semantic_template VARCHAR(128) NOT NULL COMMENT '语义层模板',
  sql_hash         VARCHAR(64)  NOT NULL COMMENT 'SQL 指纹',
  sql_text         TEXT         NULL COMMENT '渲染后SQL（脱敏，可配置不落）',
  result_type      VARCHAR(32)  NOT NULL COMMENT 'card/table/count/reject/error',
  result_count     INT          NULL COMMENT '结果行数/总数',
  result_summary   JSON         NULL COMMENT '结果摘要（不含明细）',
  status           VARCHAR(16)  NOT NULL COMMENT 'success/empty/error/timeout',
  error_code       VARCHAR(64)  NULL,
  latency_ms       INT          NOT NULL,
  data_updated_at  DATETIME(3)  NULL COMMENT '湖表数据时间',
  created_at       DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  UNIQUE KEY uk_execution_id (execution_id),
  KEY idx_session (session_id),
  KEY idx_trace (trace_id),
  KEY idx_intent_status (intent_code, status),
  KEY idx_created_at (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='查询执行记录';
```

### 5.5 审计日志表 `rt_audit_log`

```sql
CREATE TABLE rt_audit_log (
  id                BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  trace_id          VARCHAR(64)  NOT NULL,
  session_id        VARCHAR(64)  NULL,
  user_id           VARCHAR(64)  NOT NULL,
  user_role         VARCHAR(32)  NOT NULL,
  action_type       VARCHAR(32)  NOT NULL COMMENT 'query/clarify/config_change/export/admin_access',
  raw_query         VARCHAR(1024) NULL COMMENT '原始问题（脱敏）',
  intent_code       VARCHAR(64)  NULL,
  confidence        DECIMAL(4,3) NULL COMMENT '意图置信度',
  slots_json        JSON         NULL,
  clarify_rules     JSON         NULL COMMENT '触发的澄清规则',
  permission_filter JSON         NULL,
  result_type       VARCHAR(32)  NULL,
  result_count      INT          NULL,
  status            VARCHAR(16)  NOT NULL COMMENT 'success/fail/reject',
  error_code        VARCHAR(64)  NULL,
  client_ip         VARCHAR(64)  NULL,
  user_agent        VARCHAR(256) NULL,
  latency_ms        INT          NULL,
  created_at        DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  KEY idx_trace (trace_id),
  KEY idx_user_time (user_id, created_at),
  KEY idx_action_time (action_type, created_at),
  KEY idx_status_time (status, created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='审计日志';
```

> 审计日志按月分区或按 `created_at` 归档；`raw_query` 入库前脱敏（手机号、邮箱、证件号）。

### 5.6 埋点事件表 `rt_event_log`

```sql
CREATE TABLE rt_event_log (
  id           BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  event_name   VARCHAR(64)  NOT NULL COMMENT 'query_submitted/intent_recognized/clarify_shown/clarify_selected/query_executed/result_viewed/followup_clicked/reject_shown/error_shown',
  session_id   VARCHAR(64)  NULL,
  user_id      VARCHAR(64)  NOT NULL,
  trace_id     VARCHAR(64)  NULL,
  properties   JSON         NOT NULL COMMENT '事件属性',
  event_time   DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  KEY idx_event_time (event_name, event_time),
  KEY idx_user_time (user_id, event_time),
  KEY idx_session (session_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='埋点事件';
```

> 高频埋点可先写日志/MQ，批量入湖，MySQL 仅保留近 7–30 天。

### 5.7 降级/异常记录表 `rt_error_log`

```sql
CREATE TABLE rt_error_log (
  id           BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  trace_id     VARCHAR(64)  NOT NULL,
  service_name VARCHAR(64)  NOT NULL COMMENT 'ai-service/orchestrator/query-service',
  error_code   VARCHAR(64)  NOT NULL,
  error_message VARCHAR(1024) NULL,
  context_json JSON         NULL COMMENT '上下文（脱敏）',
  degraded     TINYINT(1)   NOT NULL DEFAULT 0 COMMENT '是否触发降级',
  created_at   DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (id),
  KEY idx_trace (trace_id),
  KEY idx_service_time (service_name, created_at),
  KEY idx_error_time (error_code, created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='异常与降级日志';
```

